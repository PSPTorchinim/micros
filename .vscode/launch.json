    {
      "name": "CMS: Strapi Debug",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/CMS",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "develop"],
      "skipFiles": ["<node_internals>/**"],
      "preLaunchTask": "build-strapi",
      "env": {
        "DATABASE_CLIENT": "postgres",
        "DATABASE_HOST": "localhost",
        "DATABASE_PORT": "5432",
        "DATABASE_NAME": "strapi",
        "DATABASE_USERNAME": "postgres",
        "DATABASE_PASSWORD": "postgres",
        "NODE_ENV": "development",
        "APP_KEYS": "devKeyA,devKeyB,devKeyC,devKeyD",
        "API_TOKEN_SALT": "devApiTokenSalt123",
        "TRANSFER_TOKEN_SALT": "devTransferTokenSalt123",
        "JWT_SECRET": "devJwtSecretChangeMe",
        "ADMIN_JWT_SECRET": "devAdminJwtSecretChangeMe",
        "ENCRYPTION_KEY": "devEncryptionKeyChangeMe1234567890",
        "DATABASE_SSL": "false"
      }
    },
