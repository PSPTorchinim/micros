{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-djhostgateway",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/Services/DJHostGateway/DJHostGateway.csproj"
      ],
      "group": "build",
      "dependsOrder": "sequence",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build-identityapi",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/Services/IdentityAPI/IdentityAPI.csproj"
      ],
      "group": "build",
      "dependsOrder": "sequence",
      "dependsOn": "build-djhostgateway",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build-musicapi",
      "command": "dotnet",
      "type": "process",
      "args": ["build", "${workspaceFolder}/Services/MusicAPI/MusicAPI.csproj"],
      "group": "build",
      "dependsOrder": "sequence",
      "dependsOn": "build-identityapi",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build-equipmentapi",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/Services/EquipmentAPI/EquipmentAPI.csproj"
      ],
      "group": "build",
      "dependsOrder": "sequence",
      "dependsOn": "build-musicapi",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build-documentsapi",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/Services/DocumentsAPI/DocumentsAPI.csproj"
      ],
      "group": "build",
      "dependsOrder": "sequence",
      "dependsOn": "build-equipmentapi",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build-companyapi",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/Services/CompanyAPI/CompanyAPI.csproj"
      ],
      "group": "build",
      "dependsOrder": "sequence",
      "dependsOn": "build-documentsapi",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build-partyapi",
      "command": "dotnet",
      "type": "process",
      "args": ["build", "${workspaceFolder}/Services/PartyAPI/PartyAPI.csproj"],
      "group": "build",
      "dependsOrder": "sequence",
      "dependsOn": "build-companyapi",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build-mailingapi",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/Services/MailingAPI/MailingAPI.csproj"
      ],
      "group": "build",
      "dependsOrder": "sequence",
      "dependsOn": "build-partyapi",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "install-dj-panel",
      "type": "npm",
      "script": "install",
      "path": "Frontends/dj-panel",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "build-dj-panel",
      "type": "npm",
      "script": "build:dev",
      "path": "Frontends/dj-panel",
      "group": "build",
      "dependsOn": "install-dj-panel",
      "problemMatcher": []
    },
    {
      "label": "storybook-build",
      "type": "npm",
      "script": "build-storybook",
      "path": "Frontends/dj-panel",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "install-strapi",
      "type": "npm",
      "script": "install",
      "path": "CMS",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "generate-strapi-types",
      "type": "npm",
      "script": "ts:generate-types",
      "path": "CMS",
      "group": "build",
      "dependsOn": "install-strapi",
      "problemMatcher": [],
      "options": {
        "env": {
          "NODE_ENV": "development",
          "DATABASE_CLIENT": "postgres",
          "DATABASE_HOST": "localhost",
          "DATABASE_PORT": "5432",
          "DATABASE_NAME": "djbeatblaster_cms",
          "DATABASE_USERNAME": "postgres",
          "DATABASE_PASSWORD": "postgres",
          "HOST": "0.0.0.0",
          "PORT": "1337",
          "APP_KEYS": "LocalDevelopmentAppKey1,LocalDevelopmentAppKey2,LocalDevelopmentAppKey3,LocalDevelopmentAppKey4",
          "JWT_SECRET": "LocalDevelopmentJWTSecret123456789012345678901234567890",
          "ADMIN_JWT_SECRET": "LocalDevelopmentAdminJWTSecret123456789012345678901234567890",
          "API_TOKEN_SALT": "LocalDevelopmentAPITokenSalt123456789012345678901234567890",
          "TRANSFER_TOKEN_SALT": "LocalDevelopmentTransferTokenSalt123456789012345678901234567890",
          "ENCRYPTION_KEY": "LocalDevelopmentEncryptionKey123456789012345678901234567890"
        }
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      }
    },
    {
      "label": "build-strapi",
      "type": "npm",
      "script": "build",
      "path": "CMS",
      "group": "build",
      "dependsOn": ["install-strapi", "generate-strapi-types"],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "build-all-services-sequential",
      "dependsOn": "build-mailingapi",
      "group": "build",
      "dependsOrder": "sequence"
    },

    // ================================================
    // DOCKER COMPOSE TASKS
    // ================================================

    {
      "label": "docker: compose up infra",
      "type": "shell",
      "command": "docker compose -f Docker/dj-panel-composer.yml --env-file Docker/.env --profile infra up -d",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "none",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      },
      "problemMatcher": []
    },
    {
      "label": "docker: compose up backend",
