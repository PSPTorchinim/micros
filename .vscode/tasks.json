{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-djhostgateway",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/Services/DJHostGateway/DJHostGateway.csproj"
      ],
      "group": "build",
      "dependsOrder": "sequence",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build-identityapi",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/Services/IdentityAPI/IdentityAPI.csproj"
      ],
      "group": "build",
      "dependsOrder": "sequence",
      "dependsOn": "build-djhostgateway",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build-musicapi",
      "command": "dotnet",
      "type": "process",
      "args": ["build", "${workspaceFolder}/Services/MusicAPI/MusicAPI.csproj"],
      "group": "build",
      "dependsOrder": "sequence",
      "dependsOn": "build-identityapi",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build-equipmentapi",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/Services/EquipmentAPI/EquipmentAPI.csproj"
      ],
      "group": "build",
      "dependsOrder": "sequence",
      "dependsOn": "build-musicapi",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build-documentsapi",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/Services/DocumentsAPI/DocumentsAPI.csproj"
      ],
      "group": "build",
      "dependsOrder": "sequence",
      "dependsOn": "build-equipmentapi",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build-companyapi",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/Services/CompanyAPI/CompanyAPI.csproj"
      ],
      "group": "build",
      "dependsOrder": "sequence",
      "dependsOn": "build-documentsapi",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build-partyapi",
      "command": "dotnet",
      "type": "process",
      "args": ["build", "${workspaceFolder}/Services/PartyAPI/PartyAPI.csproj"],
      "group": "build",
      "dependsOrder": "sequence",
      "dependsOn": "build-companyapi",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build-mailingapi",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/Services/MailingAPI/MailingAPI.csproj"
      ],
      "group": "build",
      "dependsOrder": "sequence",
      "dependsOn": "build-partyapi",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "install-dj-panel",
      "type": "npm",
      "script": "install",
      "path": "Frontends/dj-panel",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "build-dj-panel",
      "type": "npm",
      "script": "build:dev",
      "path": "Frontends/dj-panel",
      "group": "build",
      "dependsOn": "install-dj-panel",
      "problemMatcher": []
    },
    {
      "label": "storybook-build",
      "type": "npm",
      "script": "build-storybook",
      "path": "Frontends/dj-panel",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "install-strapi",
      "type": "npm",
      "script": "install",
      "path": "CMS",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "generate-strapi-types",
      "type": "npm",
      "script": "ts:generate-types",
      "path": "CMS",
      "group": "build",
      "dependsOn": "install-strapi",
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      }
    },
    {
      "label": "build-strapi",
      "type": "npm",
      "script": "build",
      "path": "CMS",
      "group": "build",
      "dependsOn": ["install-strapi", "generate-strapi-types"],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "build-all-services-sequential",
      "dependsOn": "build-mailingapi",
      "group": "build",
      "dependsOrder": "sequence"
    }
  ]
}
