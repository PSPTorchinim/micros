{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-djhostgateway",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/Services/DJHostGateway/DJHostGateway.csproj"
      ],
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build-identityapi",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/Services/IdentityAPI/IdentityAPI.csproj"
      ],
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build-musicapi",
      "command": "dotnet",
      "type": "process",
      "args": ["build", "${workspaceFolder}/Services/MusicAPI/MusicAPI.csproj"],
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build-equipmentapi",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/Services/EquipmentAPI/EquipmentAPI.csproj"
      ],
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build-documentsapi",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/Services/DocumentsAPI/DocumentsAPI.csproj"
      ],
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build-companyapi",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/Services/CompanyAPI/CompanyAPI.csproj"
      ],
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build-partyapi",
      "command": "dotnet",
      "type": "process",
      "args": ["build", "${workspaceFolder}/Services/PartyAPI/PartyAPI.csproj"],
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build-mailingapi",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/Services/MailingAPI/MailingAPI.csproj"
      ],
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "install-dj-panel",
      "type": "npm",
      "script": "install",
      "path": "Frontends/dj-panel",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "build-dj-panel",
      "type": "npm",
      "script": "build:dev",
      "path": "Frontends/dj-panel",
      "group": "build",
      "dependsOn": "install-dj-panel",
      "problemMatcher": []
    },
    {
      "label": "install-strapi",
      "type": "npm",
      "script": "install",
      "path": "CMS",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "build-all-services",
      "dependsOrder": "sequence",
      "dependsOn": [
        "build-djhostgateway",
        "build-identityapi",
        "build-musicapi",
        "build-equipmentapi",
        "build-documentsapi",
        "build-companyapi",
        "build-partyapi",
        "build-mailingapi"
      ],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "build-all-frontends",
      "dependsOrder": "sequence",
      "dependsOn": ["build-dj-panel", "install-strapi"],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "build-all",
      "dependsOrder": "sequence",
      "dependsOn": ["build-all-services", "build-all-frontends"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
