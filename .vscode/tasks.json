{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-shared",
      "command": "dotnet",
      "type": "process",
      "args": ["build", "${workspaceFolder}/Services/Shared/Shared.csproj"],
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build-djhostgateway",
      "command": "dotnet",
