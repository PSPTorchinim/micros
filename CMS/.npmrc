# Enable legacy-peer-deps to allow React 19 with Strapi 5.31.2
# Strapi 5.31.2 officially supports React ^17.0.0 || ^18.0.0, but React 19 works correctly.
# This setting bypasses peer dependency validation for React compatibility.
# TODO: Remove this when Strapi officially supports React 19.
# See: https://github.com/strapi/strapi/issues (monitor for React 19 support)
legacy-peer-deps=true
