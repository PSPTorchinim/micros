{
  "kind": "collectionType",
  "collectionName": "pages",
  "info": {
    "singularName": "page",
    "pluralName": "pages",
    "displayName": "Page"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "Title": {
      "type": "string"
    },
    "Slug": {
      "type": "string"
    },
    "Visible": {
      "type": "boolean",
      "default": true
    },
    "subpages": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::page.page",
      "inversedBy": "Parents"
    },
    "Parents": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::page.page",
      "mappedBy": "subpages"
    },
    "configuration": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::configuration.configuration",
      "inversedBy": "pages"
    },
    "Menu": {
      "type": "enumeration",
      "default": "Main",
      "enum": [
        "Main",
        "Login"
      ]
    },
    "NavigationOrder": {
      "type": "integer"
    },
    "NavigationAction": {
      "type": "enumeration",
      "default": "Link",
      "enum": [
        "Link",
        "Action"
      ]
    },
    "template": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::template.template",
      "inversedBy": "page"
    }
  }
}
