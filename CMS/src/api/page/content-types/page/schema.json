{
  "kind": "collectionType",
  "collectionName": "pages",
  "info": {
    "singularName": "page",
    "pluralName": "pages",
    "displayName": "Page"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "PageID": {
      "type": "uid",
      "targetField": "Name",
      "required": true
    },
    "Name": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "required": true,
      "unique": true
    },
    "URL": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "required": true
    },
    "hero_image": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::hero-image.hero-image"
    },
    "subpages": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::page.page",
      "inversedBy": "pages"
    },
    "pages": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::page.page",
      "mappedBy": "subpages"
    }
  }
}
