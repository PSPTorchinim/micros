{
  "kind": "collectionType",
  "collectionName": "templates",
  "info": {
    "singularName": "template",
    "pluralName": "templates",
    "displayName": "Template"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "Name": {
      "type": "string"
    },
    "TemplateType": {
      "type": "enumeration",
      "enum": [
        "Standard",
        "Login",
        "ForgotPassword",
        "ChangePassword",
        "Profile",
        "Company"
