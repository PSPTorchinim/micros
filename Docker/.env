# ================================================
# DJ Panel Microservices Environment Configuration
# ================================================
# Generated for Docker Compose setup
# Make sure to update passwords and secrets before production use!

# ================================================
# DATABASE CONFIGURATION
# ================================================

# MongoDB Configuration
DATABASE_HOST_MONGODB=mongodb_container
DATABASE_PORT_MONGODB=27017
DATABASE_USER_MONGODB=djpanel_mongo_admin
DATABASE_PASSWORD_MONGODB=djpanel_mongo_strong_password_2024

# SQL Server Configuration
DATABASE_HOST_SQLSERVER=sqlserver
DATABASE_PORT_SQLSERVER=1433
DATABASE_USER_SQLSERVER=sa
DATABASE_PASSWORD_SQLSERVER=DJPanel_SQL_Strong_Password_2024!

# PostgreSQL Configuration (for Strapi CMS)
CMS_DATABASE_NAME=djpanel_strapi_db
CMS_DATABASE_USERNAME=strapi_user
CMS_DATABASE_PASSWORD=strapi_strong_password_2024
CMS_DATABASE_HOST=strapi_db
CMS_DATABASE_PORT=5432

# ================================================
# CACHING & MESSAGE QUEUE CONFIGURATION
# ================================================

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=djpanel_redis_strong_password_2024

# RabbitMQ Configuration
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=djpanel_rabbitmq_user
RABBITMQ_PASSWORD=djpanel_rabbitmq_strong_password_2024

# ================================================
# SECURITY & AUTHENTICATION
# ================================================

# JWT and Security Keys (CHANGE THESE IN PRODUCTION!)
SECURE_KEY=djpanel_secure_key_change_in_production_2024_very_long_secret_key
JWT_KEY=djpanel_jwt_secret_key_change_in_production_2024_very_long_jwt_secret

# Default DJ Panel User
DJPANEL_USER_EMAIL=admin@djbeatblaster.com
DJPANEL_USER_PASSWORD=DJPanel_Admin_Password_2024!

# ================================================
# MICROSERVICES INTERNAL ADDRESSES
# ================================================

# Backend Service Addresses (internal Docker network)
IDENTITY_BE_ADDRESS=http://identity_be:8080
MUSIC_BE_ADDRESS=http://music_be:8080
GEAR_BE_ADDRESS=http://gear_be:8080
DOCUMENTS_BE_ADDRESS=http://documents_be:8080
BRAND_BE_ADDRESS=http://brand_be:8080
PARTY_BE_ADDRESS=http://party_be:8080
MAILING_BE_ADDRESS=http://mailing_be:8080

# ================================================
# DATABASE CATALOGS PER SERVICE
# ================================================

# Each microservice gets its own database catalog
APIGATEWAY_DATABASE_CATALOG=DJPanel_Gateway
IDENTITY_DATABASE_CATALOG=DJPanel_Identity
MUSIC_DATABASE_CATALOG=DJPanel_Music
GEAR_DATABASE_CATALOG=DJPanel_Equipment
DOCUMENTS_DATABASE_CATALOG=djpanel_documents
BRAND_DATABASE_CATALOG=DJPanel_Company
PARTY_DATABASE_CATALOG=DJPanel_Party
MAILING_DATABASE_CATALOG=DJPanel_Mailing

# ================================================
# FRONTEND CONFIGURATION
# ================================================

# API Gateway endpoint for frontend
API_GATEWAY=http://localhost:3000

# ================================================
# CMS (STRAPI) CONFIGURATION
# ================================================

# Strapi Database Client
CMS_DATABASE_CLIENT=postgres

# Strapi Environment
CMS_NODE_ENV=development

# Strapi Security Keys (CHANGE THESE IN PRODUCTION!)
CMS_JWT_SECRET=strapi_jwt_secret_change_in_production_2024_very_long_secret
CMS_ADMIN_JWT_SECRET=strapi_admin_jwt_secret_change_in_production_2024_very_long_secret
CMS_APP_KEYS=strapi_app_key1_2024,strapi_app_key2_2024,strapi_app_key3_2024,strapi_app_key4_2024
CMS_API_TOKEN_SALT=strapi_api_token_salt_change_in_production_2024_very_long_salt
CMS_TRANSFER_TOKEN_SALT=strapi_transfer_token_salt_change_in_production_2024_very_long_salt
CMS_ENCRYPTION_KEY=strapi_encryption_key_change_in_production_2024_32char

# ================================================
# ENVIRONMENT SETTINGS
# ================================================

# Application Environment
ENVIRONMENT=Development

# ================================================
# LOGGING & MONITORING CONFIGURATION
# ================================================

# Grafana Configuration
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=djpanel_grafana_admin_2024

# ================================================
# NOTES FOR PRODUCTION DEPLOYMENT
# ================================================
# 1. Change all passwords and secret keys
# 2. Use strong, unique passwords (minimum 16 characters)
# 3. Consider using Docker secrets or external secret management
# 4. Update database hosts to external services if not using containers
# 5. Enable SSL/TLS for database connections
# 6. Configure proper backup strategies for databases
# 7. Set ENVIRONMENT=Production for production deployment
# 8. Review and update CORS and security policies
# 9. Configure proper logging and monitoring
# 10. Change GRAFANA_ADMIN_PASSWORD for production
# 11. Ensure proper network security and firewall rules
# 12. Configure GitHub secrets for sensitive credentials in CI/CD pipelines