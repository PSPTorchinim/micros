  "scripts": {
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "build:start": "cd dist && npx serve",
    "dev": "webpack serve --mode development --live-reload --hot --port 3080",
    "prod": "webpack serve --mode production --port 3000",
    "staging": "webpack serve --mode staging --port 3000",
    "start:live": "webpack serve --mode development --live-reload --hot --port 3000",
    "test": "jest --passWithNoTests",
    "lint": "eslint \"src/**/*.{js,jsx,ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{js,jsx,ts,tsx}\" --fix",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "map:api": "node scripts/map-api.js",
    "map:strapi": "node scripts/map-strapi.js"
  },
