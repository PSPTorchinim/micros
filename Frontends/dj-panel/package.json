{
  "name": "dj-panel",
  "version": "1.0.0",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--max-old-space-size=4096\" webpack --mode production",
    "build:dev": "webpack --mode development",
    "build:start": "cd dist && npx serve",
    "dev": "webpack serve --mode development --live-reload --hot --port 3080",
    "prod": "webpack serve --mode production --port 3000",
    "staging": "webpack serve --mode staging --port 3000",
    "start:live": "webpack serve --mode development --live-reload --hot --port 3000",
    "test": "jest --passWithNoTests",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:all": "npm run test && npm run test:e2e",
    "lint": "eslint \"src/**/*.{js,jsx,ts,tsx}\" --ignore-pattern src/models/strapi/** --ignore-pattern src/models/api/** --no-error-on-unmatched-pattern",
    "lint:fix": "eslint \"src/**/*.{js,jsx,ts,tsx}\" --fix --ignore-pattern src/models/strapi/** --ignore-pattern src/models/api/** --no-error-on-unmatched-pattern",
    "format": "prettier --check \"src/**/*.{js,jsx,ts,tsx,json,css,scss,md}\" --ignore-path .prettierignore",
    "format:fix": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,scss,md}\" --ignore-path .prettierignore",
    "map:api": "node scripts/map-api.js",
    "map:strapi": "node scripts/map-strapi.js",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "cross-env NODE_OPTIONS=\"--localstorage-file=./node_modules/.cache/storybook-localstorage\" storybook build"
  },
  "license": "UNLICENSED",
  "author": "PSPTorchinim",
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/plugin-transform-runtime": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@playwright/test": "^1.56.1",
    "@storybook/addon-docs": "^10.0.8",
    "@storybook/addon-onboarding": "^10.0.8",
    "@storybook/addon-webpack5-compiler-swc": "^4.0.2",
    "@storybook/react-webpack5": "^10.0.8",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/babel__generator": "^7.27.0",
    "@types/babel__template": "^7.4.4",
    "@types/babel__traverse": "^7.28.0",
    "@types/body-parser": "^1.19.6",
    "@types/crypto-js": "^4.2.2",
    "@types/http-errors": "^2.0.5",
    "@types/istanbul-lib-report": "^3.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.1",
    "@types/prop-types": "^15.7.15",
    "@types/qs": "^6.14.0",
    "@types/range-parser": "^1.2.7",
    "@types/react": "^19.2.6",
    "@types/react-dom": "^19.2.3",
    "@types/react-helmet": "^6.1.11",
    "@types/send": "^1.2.1",
    "@types/tough-cookie": "^4.0.5",
    "@types/yargs-parser": "^21.0.3",
    "autoprefixer": "^10.4.22",
    "babel-loader": "^10.0.0",
    "css-loader": "^7.1.2",
    "dotenv-webpack": "^8.1.1",
    "eslint": "^9.39.1",
    "html-webpack-plugin": "^5.6.5",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.2.0",
    "jiti": "^2.6.1",
    "postcss": "^8.5.6",
    "postcss-loader": "^8.2.0",
    "prettier": "^3.6.2",
    "storybook": "^10.0.8",
    "style-loader": "^4.0.0",
    "typescript": "^5.9.3",
    "webpack": "^5.103.0",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.2"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "buffer": "^6.0.3",
    "copy-webpack-plugin": "^13.0.1",
    "cross-env": "^10.1.0",
    "crypto": "^1.0.1",
    "crypto-browserify": "^3.12.1",
    "crypto-js": "^4.2.0",
    "dotenv": "^17.2.3",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "jest-environment-jsdom": "^30.2.0",
    "js-sha256": "^0.11.1",
    "jwt-decode": "^4.0.0",
    "marked": "^17.0.1",
    "npm-check-updates": "^19.1.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-helmet": "^6.1.0",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.9.6",
    "serve": "^14.2.5",
    "swagger-typescript-api": "^13.2.16"
  }
}
